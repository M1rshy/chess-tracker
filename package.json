    "@types/node": "^22.0.0", "@types/react": "^18.3.0", "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0", "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0", "vite": "^6.1.0", "vitest": "^3.2.0"
