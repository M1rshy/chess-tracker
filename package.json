{
  "name": "chess-vision-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "postinstall": "node scripts/copy-assets.mjs",
    "build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build && tsc -p extension/tsconfig.json --noEmit && node scripts/build-extension.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "build:extension": "tsc -p extension/tsconfig.json --noEmit && node scripts/build-extension.mjs",
    "test:extension": "node scripts/build-extension.mjs && node scripts/test-extension.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.11.0-release.1",
    "chess.js": "1.4.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.22.0",
    "react": "18.3.1",
    "react-chessboard": "4.7.3",
    "react-dom": "18.3.1",
    "stockfish": "17.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
